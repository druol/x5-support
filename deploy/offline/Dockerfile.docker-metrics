# CI-сборка: Go-бинарник + минимальный runtime.
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY backend/go.mod backend/go.sum ./backend/
RUN cd backend && go mod download
COPY backend ./backend
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath \
  -ldflags="-s -w" -o /out/x5-docker-metrics ./backend/cmd/docker-metrics

FROM caddy:2.9-alpine
COPY --from=build /out/x5-docker-metrics /usr/local/bin/x5-docker-metrics
EXPOSE 9101
ENTRYPOINT ["/usr/local/bin/x5-docker-metrics"]
