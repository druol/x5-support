{
	# TLS через Let's Encrypt невозможен: входящие соединения из-за рубежа
	# до этой ВМ не доходят (фильтрация на стороне облака/сети).
	# Включаем обычный HTTP; при появлении домена и снятии фильтра — вернём HTTPS.
	auto_https off
	email {$ACME_EMAIL}
}

:80 {
	encode zstd gzip

	reverse_proxy app:8080 {
		health_uri /healthz
		health_interval 30s
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format json
	}
}
