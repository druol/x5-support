# ─────────────────────────────────────────────────────────────────────────────
# Скопируйте в .env и поменяйте пароли перед публикацией на сервере.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Приложение ───────────────────────────────────────────────────────────────
# 127.0.0.1 — доступно только с этой машины; 0.0.0.0 — со всей локальной сети.
BIND_ADDR=127.0.0.1
# 8090 вместо 8080: на macOS порт 8080 иногда занят системными/старыми процессами
APP_PORT=8090
TZ=Europe/Moscow

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_DB=orbita
POSTGRES_USER=orbita
POSTGRES_PASSWORD=orbita_local_password
# 55432 вместо 5432: чтобы не конфликтовать с локальным Postgres
POSTGRES_PORT=55432

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── Grafana / мониторинг ─────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=orbita_admin
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
JAEGER_UI_PORT=16686

# ── GitLab (локальный, отдельный compose) ────────────────────────────────────
GITLAB_ROOT_PASSWORD=change-me-before-use
GITLAB_WEB_PORT=8929
GITLAB_SSH_PORT=2222

# ── Публикация на сервере (docker-compose.prod.yml) ──────────────────────────
DOMAIN=example.ru
ACME_EMAIL=admin@example.ru

# ── Отладка (локально) ───────────────────────────────────────────────────────
# 1 — включает POST /api/debug/{notifications,tickets} и кнопки очистки в сайдбаре.
# На сервере оставлять 0/пусто.
DEBUG_RESET=0
